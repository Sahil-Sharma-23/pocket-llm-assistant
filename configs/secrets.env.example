# Copy to configs/secrets.env, fill in, then: chmod 600 configs/secrets.env
# scripts/start.sh loads this file (and refuses it unless mode is 600/400).
# Never commit configs/secrets.env (it is in .gitignore).

# Telegram bot token from @BotFather (also set telegram.enabled=true).
PA_TELEGRAM_TOKEN=

# Optional: GitHub token (read-only, public repos) raises the API limit
# from 60 to 5000 requests/hour. Leave empty to use unauthenticated access.
PA_GITHUB_TOKEN=
